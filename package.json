{
  "name": "kubit-forge",
  "version": "0.0.2-canary.14",
  "description": "World-class CLI for modern web development with enterprise-grade features: plugins, recipes, and DAG task engine",
  "main": "dist/index.js",
  "bin": {
    "kubit-forge": "dist/cli.js",
    "kubit": "dist/cli.js"
  },
  "type": "module",
  "author": "Kubit Team <team@kubit-forge.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubit-ui/kubit-forge.git"
  },
  "bugs": {
    "url": "https://github.com/kubit-ui/kubit-forge/issues"
  },
  "homepage": "https://github.com/kubit-ui/kubit-forge#readme",
  "license": "MIT",
  "keywords": [
    "cli",
    "react",
    "vite",
    "typescript",
    "developer-tools",
    "scaffolding",
    "build-tool",
    "dag",
    "task-runner",
    "plugin-system",
    "recipes",
    "kubit-spec",
    "open-source",
    "doctor-command",
    "auto-fix",
    "predictive-analysis",
    "enterprise",
    "modern-web-development"
  ],
  "scripts": {
    "dist": "pnpm run build",
    "build": "pnpm run clean && tsup",
    "dev": "NODE_ENV=development tsup --watch",
    "dev:link": "pnpm build && pnpm link --global",
    "dev:unlink": "pnpm unlink --global kubit-forge",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ci": "vitest --coverage.enabled=true --silent --run",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "postinstall": "echo 'postinstall completed'",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --verbose"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.2.4",
    "enquirer": "^2.4.1",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "ora": "^9.3.0",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^10.0.0",
    "eslint-config-kubit": "^2.0.1",
    "happy-dom": "^20.6.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.29.2"
}
