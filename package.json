{
  "name": "kubit-forge",
  "version": "0.0.2-canary.24",
  "description": "World-class CLI for modern web development with enterprise-grade features: plugins, recipes, and DAG task engine",
  "main": "dist/index.js",
  "bin": {
    "kubit": "dist/cli.js",
    "kubit-forge": "dist/cli.js"
  },
  "type": "module",
  "author": "Kubit Team <team@kubit-forge.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubit-ui/kubit-forge.git"
  },
  "bugs": {
    "url": "https://github.com/kubit-ui/kubit-forge/issues"
  },
  "homepage": "https://github.com/kubit-ui/kubit-forge#readme",
  "license": "MIT",
  "keywords": [
    "cli",
    "react",
    "vite",
    "typescript",
    "developer-tools",
    "scaffolding",
    "build-tool",
    "dag",
    "task-runner",
    "plugin-system",
    "recipes",
    "kubit-spec",
    "open-source",
    "doctor-command",
    "auto-fix",
    "predictive-analysis",
    "enterprise",
    "modern-web-development"
  ],
  "scripts": {
    "dist": "yarn build",
    "build": "yarn clean && tsup",
    "dev": "NODE_ENV=development tsup --watch",
    "dev:link": "yarn build && yarn link",
    "dev:unlink": "yarn unlink kubit-forge",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ci": "vitest --coverage.enabled=true --silent --run",
    "lint": "oxlint -c .oxlintrc.json src",
    "lint:fix": "oxlint -c .oxlintrc.json src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn build",
    "postinstall": "echo 'postinstall completed'",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --verbose"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "enquirer": "^2.4.1",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "ora": "^9.3.0",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^29.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
